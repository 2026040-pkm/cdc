{
  "uid": "hotdb-engine",
  "title": "HotDB 엔진 자원",
  "tags": [
    "hotdb",
    "cdc",
    "engine"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "① 엔진이 프로세스 안에서 쓰는 자원 (평시 · 1만 건 배치 · 적체)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "엔진 CPU 몫 (프로세스 대비)",
      "description": "Debezium 스레드 CPU / 프로세스 CPU. 배치 콜백(우리 반영)은 빠진 순수 캡처 몫",
      "datasource": {
        "type": "prometheus",
        "uid": "hotdb-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotdb-prom"
          },
          "expr": "hotdb:engine_cpu_share{pipeline=~\"$pipeline\"}",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "엔진 힙 할당 몫",
      "description": "GC 는 할당한 쪽에 안 붙는다 — 할당 몫이 GC 를 누가 부르는지 말해 준다",
      "datasource": {
        "type": "prometheus",
        "uid": "hotdb-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotdb-prom"
          },
          "expr": "sum by (pipeline) (rate(hotdb_cdc_engine_alloc_bytes_total{part=\"engine\",pipeline=~\"$pipeline\"}[1m])) / sum by (pipeline) (rate(hotdb_cdc_engine_alloc_bytes_total{part=\"process\",pipeline=~\"$pipeline\"}[1m]))",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "엔진 스레드",
      "description": "엔진 스레드 그룹의 살아 있는 스레드",
      "datasource": {
        "type": "prometheus",
        "uid": "hotdb-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotdb-prom"
          },
          "expr": "hotdb_cdc_engine_threads{pipeline=~\"$pipeline\"}",
          "legendFormat": "{{pipeline}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "프로세스 CPU 몫별 (코어)",
      "description": "engine = 슬롯 읽기 · 해석 · 큐 / handler = 배치 콜백(라우트 반영 · RFC 전달) / work:judge = 판정 · work:poll = 레거시 폴링 / JVM 나머지 = GC · JIT · HTTP",
      "datasource": {
        "type": "prometheus",
        "uid": "hotdb-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotdb-prom"
          },
          "expr": "hotdb:proc_cpu_cores{pipeline=~\"$pipeline\", part!=\"process\"}",
          "legendFormat": "{{pipeline}} {{part}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "hotdb-prom"
          },
          "expr": "sum by (pipeline) (hotdb:proc_cpu_cores{pipeline=~\"$pipeline\", part=\"process\"}) - sum by (pipeline) (hotdb:proc_cpu_cores{pipeline=~\"$pipeline\", part!=\"process\"})",
          "legendFormat": "{{pipeline}} JVM 나머지"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
