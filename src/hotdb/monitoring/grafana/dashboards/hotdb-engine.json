      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "hotdb-prom"
          },
          "expr": "sum by (pipeline) (jvm_memory_used_bytes{area=\"heap\",pipeline=~\"$pipeline\"})",
          "legendFormat": "{{pipeline}} 사용"
