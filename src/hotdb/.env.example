# 서버 to 서버로 나눠 띄울 때 복사해서 .env 로 쓴다 (compose 가 자동으로 읽는다)

# ── OT 서버 (권역 서비스 · 발행기) ──────────────────────────────────
# HotDB 서버 주소와 그 서버가 밖으로 연 포트
HOTDB_HOST=10.0.0.10
HOTDB_PORT=59433

# ── HotDB 서버 ──────────────────────────────────────────────────────
# 실서버 RAM 32GB 기준 (timescaledb-tune 권장값으로 다시 맞춘다)
# HOTDB_SHARED_BUFFERS=8GB
# HOTDB_ADMIN_PASSWORD=바꿀것

# ── 모니터링 서버 ───────────────────────────────────────────────────
# Grafana 가 DB 를 직접 읽을 주소
# HOTDB_ADDR=10.0.0.10:59433

# ── RFC AGENT · DB AGENT 서버 — 레거시 DB(compose.legacy.yml) 주소 ──
# LEGACY_HOST=10.0.0.11
# LEGACY_PORT=59435
