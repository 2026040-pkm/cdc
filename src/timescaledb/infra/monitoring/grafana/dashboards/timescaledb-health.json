    {
      "id": 4,
      "type": "stat",
      "title": "압축률",
      "description": "압축된 청크 기준 1 − after/before. 압축된 청크가 없으면 0",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tsdb-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tsdb-prom"
          },
          "expr": "(tsdb_compression_before_bytes - tsdb_compression_after_bytes) / clamp_min(tsdb_compression_before_bytes, 1)",
          "legendFormat": "절감",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
