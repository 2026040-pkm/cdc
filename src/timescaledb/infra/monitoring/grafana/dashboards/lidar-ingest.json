      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "tsdb-db"
          },
          "rawQuery": true,
          "rawSql": "SELECT tid, zone, bay, status, error_code, temperature_c,\n       scan_rate_pts_per_sec AS scan_rate, connectivity_rssi AS rssi, fov_mode,\n       last_event_at, extract(epoch from (now() - last_event_at)) AS age_s\nFROM lidar_device_state\nORDER BY CASE status WHEN 'ERROR' THEN 0 WHEN 'OFFLINE' THEN 1 WHEN 'CALIBRATING' THEN 2 ELSE 3 END, tid",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
