            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ONLINE": {
                        "color": "green",
                        "index": 0
                      },
                      "CALIBRATING": {
                        "color": "blue",
                        "index": 1
                      },
                      "ERROR": {
                        "color": "red",
                        "index": 2
                      },
                      "OFFLINE": {
